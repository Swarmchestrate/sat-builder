# ============================================================================
# RUNTIME CONFIGURATION
# ============================================================================

# --- Service ---
SERVICE__ID=sat-builder
SERVICE__NAME=SAT Builder

# --- Server ---
SERVER__HOST=0.0.0.0
SERVER__PORT=8000
SERVER__RELOAD=false
SERVER__LOG_LEVEL=info

# --- Profile ---
# The TOSCA profile is the source of truth for types and constraints.
#
# SOURCE is where the profile is read from: a published profile.yaml URL, or a
# local directory when developing against unpublished profile changes.
# IMPORT_URL is what generated documents import, which is always the published
# profile regardless of where SOURCE read it from.
#
# A URL source is mirrored into CACHE_DIR and re-checked with conditional GETs
# every REFRESH_SECONDS; an unchanged profile costs one 304 per file. The check
# runs on every build request, so a published profile change reaches a running
# service without a restart. 300 matches raw.githubusercontent.com's own cache -
# checking more often cannot see anything newer. The cache is also the offline
# fallback, so a failed fetch does not stop the service booting. Set
# OFFLINE=true to skip the network entirely.
PROFILE__SOURCE=https://raw.githubusercontent.com/Swarmchestrate/tosca/refs/heads/main/profiles/eu.swarmchestrate/profile.yaml
PROFILE__IMPORT_URL=https://raw.githubusercontent.com/Swarmchestrate/tosca/refs/heads/main/profiles/eu.swarmchestrate/profile.yaml
PROFILE__NAMESPACE=swch
PROFILE__CACHE_DIR=profile_cache
PROFILE__REFRESH_SECONDS=300
PROFILE__OFFLINE=false

# --- Validation ---
# Overrides validation.sardou in configs/app.yaml.
# Sardou needs the Puccini binary at /usr/bin/puccini-tosca, which is installed
# in the Docker image but is Linux-only. Set to false to run outside Docker.
APP__VALIDATION__SARDOU=true

# --- CORS ---
CORS__ENABLED=false
CORS__ORIGINS=*
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=*
CORS__ALLOW_HEADERS=*

# --- Logging ---
LOGGING__LEVEL=INFO
LOGGING__TO_FILE=true
LOGGING__TO_CONSOLE=true
LOGGING__FILE_PATH=logs/app.log
LOGGING__ERROR_FILE_PATH=logs/error.log
LOGGING__ACCESS_FILE_PATH=logs/access.log
LOGGING__SEPARATE_ERROR_LOG=true
LOGGING__SEPARATE_ACCESS_LOG=true
LOGGING__MAX_BYTES=10485760
LOGGING__BACKUP_COUNT=5
LOGGING__JSON_FORMAT=false
LOGGING__USE_COLORS=true
